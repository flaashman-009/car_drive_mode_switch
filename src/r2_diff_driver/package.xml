<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_diff_driver</name>
  <version>0.1.0</version>
  <description>ROS2 driver framework for software differential mode on the R2 Ackermann chassis.</description>
  <maintainer email="r2@localhost">r2 team</maintainer>
  <license>Apache-2.0</license>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>r2_diff_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
